# RangeIQ backend — environment variable template
# Copy this file to .env and fill in real values.
# The .env file is loaded automatically at startup (python-dotenv).
# Never commit the .env file with real keys.

# ── External API keys ─────────────────────────────────────────────────────────

# OpenWeatherMap API key for live temperature data.
# Without this, season-average temperatures are used and a warning is shown.
# Get a free key at https://home.openweathermap.org/users/sign_up
OPENWEATHER_API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────

# Frontend origin(s) allowed by the CORS middleware.
# Comma-separated if you have multiple origins (e.g. dev + staging).
# Default: http://localhost:5173 (Vite dev server)
FRONTEND_ORIGIN=http://localhost:5173

# ── Routing ───────────────────────────────────────────────────────────────────

# OSRM routing engine base URL.
# Default: public demo instance (subject to usage limits).
# Self-host OSRM for production: https://github.com/Project-OSRM/osrm-backend
OSRM_BASE_URL=http://router.project-osrm.org/route/v1/driving

# ── Database ──────────────────────────────────────────────────────────────────

# SQLite (default) or PostgreSQL connection string.
# Default: sqlite:///backend/data/rangeiq.db
# DATABASE_URL=sqlite:///./data/rangeiq.db
